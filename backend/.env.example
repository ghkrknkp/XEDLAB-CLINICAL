# ==============================================================================
# AI Medical Report Analyzer - Backend Environment Configuration
# ==============================================================================

APP_ENV=development
PORT=8000
HOST=0.0.0.0

JWT_SECRET=replace-with-a-secure-random-32-char-secret-key
SECRET_KEY=replace-with-a-secure-random-32-char-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=sqlite:///./medreports.db
# DATABASE_URL=postgresql://meduser:yourpassword@localhost:5432/medreports

REDIS_URL=redis://localhost:6379/0

STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10
REPORT_RETENTION_DAYS=90

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

TESSERACT_CMD=tesseract

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
