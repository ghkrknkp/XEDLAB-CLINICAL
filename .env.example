# ==============================================================================
# AI Medical Report Analyzer - Environment Configuration Template
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Generate a secure 32+ character random string for production: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key
SECRET_KEY=replace-with-a-secure-random-32-char-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./medreports.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://meduser:yourpassword@localhost:5432/medreports

# Redis & Background Processing Queue
REDIS_URL=redis://localhost:6379/0

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10
REPORT_RETENTION_DAYS=90

# S3 Storage Configuration (Required only if STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# LLM Provider Configuration (openai | gemini | none)
# Set to 'none' to use deterministic zero-cost template fallback
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OCR Configuration
TESSERACT_CMD=tesseract

# Frontend URL & CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Build Environment (for Vercel / Netlify / Vite)
VITE_API_URL=http://localhost:8000/api
